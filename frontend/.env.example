# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o .env de verdade — ele já está no .gitignore.

# URL onde o backend está rodando.
# - Rodando local + testando num EMULADOR Android: use http://10.0.2.2:8001
#   (10.0.2.2 é o endereço especial que o emulador usa pra apontar de volta
#   pro "localhost" da sua máquina host — "localhost" sozinho aponta pro
#   próprio emulador, não pra sua máquina).
# - Testando num celular físico na mesma rede: use o IP local da sua
#   máquina (ex: http://192.168.0.X:8001).
# - Produção: a URL real do servidor publicado.
EXPO_PUBLIC_BACKEND_URL="http://10.0.2.2:8001"

# Chave PUBLICÁVEL do Stripe (Dashboard > Developers > API keys — a que
# começa com pk_, nunca a sk_ que é secreta)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
