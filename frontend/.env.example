# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o .env de verdade — ele já está no .gitignore.
# Nos builds do EAS (celular de verdade / Play Store) estas variáveis vêm do EAS, não deste
# arquivo: expo.dev > seu projeto > Environment variables, no ambiente "production".
# Ver lancamento/CHAVES-PRODUCAO.md.

# URL onde o backend está rodando.
# - Rodando local + testando num EMULADOR Android: use http://10.0.2.2:8001
#   (10.0.2.2 é o endereço especial que o emulador usa pra apontar de volta
#   pro "localhost" da sua máquina host — "localhost" sozinho aponta pro
#   próprio emulador, não pra sua máquina).
# - Testando num celular físico na mesma rede: use o IP local da sua
#   máquina (ex: http://192.168.0.X:8001).
# - Produção: a URL real do servidor publicado (https).
EXPO_PUBLIC_BACKEND_URL="http://10.0.2.2:8001"

# Chave PUBLICÁVEL do Stripe (Dashboard > Developers > API keys — a que
# começa com pk_, nunca a sk_ que é secreta). Produção: pk_live_...
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Mesmo GOOGLE_WEB_CLIENT_ID do backend (é público; o segredo fica só no backend).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""

# (Opcional) Endereço do site com Termos, Privacidade e Exclusão de conta. Padrão: o do Firebase.
# EXPO_PUBLIC_WEB_URL="https://showup-509120.web.app"
