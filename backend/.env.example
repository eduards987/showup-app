# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o .env de verdade — ele já está no .gitignore.

# MongoDB (Atlas ou local)
MONGO_URL="mongodb+srv://usuario:senha@seu-cluster.mongodb.net/?retryWrites=true&w=majority"
DB_NAME="holdbooked"

# Stripe (Dashboard > Developers > API keys)
STRIPE_API_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Price IDs dos planos pagos (Dashboard > Product catalog)
STRIPE_PRICE_ID_PROFISSIONAL=""
STRIPE_PRICE_ID_ULTRA=""

# Token de serviço para rotas internas (/internal/jobs/*)
# Gere com: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=""

# Origens permitidas no CORS, separadas por vírgula
ALLOWED_ORIGINS="http://localhost:8081"

# TESTING=1 desliga o rate limiting (usar SÓ ao rodar a suíte pytest, nunca em produção)
# TESTING=1
