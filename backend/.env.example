# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o .env de verdade — ele já está no .gitignore. Em produção (Render) estas
# mesmas variáveis ficam em Environment, não em arquivo. Ver lancamento/CHAVES-PRODUCAO.md.

# --- MongoDB (Atlas ou local) ---
MONGO_URL="mongodb+srv://usuario:senha@seu-cluster.mongodb.net/?retryWrites=true&w=majority"
DB_NAME="holdbooked"

# --- Stripe (Dashboard > Developers > API keys) ---
# Teste: sk_test_... / Produção: sk_live_... (NUNCA misturar com a chave publicável do outro modo)
STRIPE_API_KEY="sk_test_..."
# Segredo do endpoint de webhook DA PLATAFORMA (Developers > Webhooks). Cada endpoint tem o seu.
STRIPE_WEBHOOK_SECRET="whsec_..."
# (Opcional) Segredo do endpoint de CONNECT ("escutar eventos em contas conectadas"): é outro whsec_.
STRIPE_CONNECT_WEBHOOK_SECRET=""

# Price IDs dos planos pagos (Product catalog). Só valem com PLANOS_COMPRA_HABILITADA=1.
STRIPE_PRICE_ID_PROFISSIONAL=""
STRIPE_PRICE_ID_ULTRA=""

# --- Login com Google (Google Cloud Console > Credenciais > Cliente OAuth "Web") ---
GOOGLE_WEB_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Tem que ser IDÊNTICA a uma "URI de redirecionamento autorizada" do cliente OAuth acima.
GOOGLE_OAUTH_REDIRECT_URI="https://SEU-BACKEND.onrender.com/api/auth/google/callback"

# --- Rotas internas e CORS ---
# Token de serviço para /internal/jobs/*. Gere com: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=""
# Origens permitidas no CORS, separadas por vírgula (inclua o site do Firebase)
ALLOWED_ORIGINS="http://localhost:8081,https://SEU-SITE.web.app"

# --- Site público (link de agendamento) ---
PUBLIC_WEB_BASE_URL="https://SEU-SITE.web.app"

# --- Interruptores de lançamento (ver lancamento/LANCAMENTO.md) ---
# 1 = só dá pra agendar com profissional cuja conta do Stripe já está liberada (repasse automático).
# Recomendado 1 em PRODUÇÃO; 0 em teste.
EXIGIR_RECEBIMENTO_ATIVO="0"
# 1 = planos pagos e teste grátis podem ser comprados no app. 0 = aparecem como "em breve".
# Para a primeira versão no Google Play, o seguro é 0 (ver LANCAMENTO.md, decisão 1).
PLANOS_COMPRA_HABILITADA="1"

# TESTING=1 desliga o rate limiting (usar SÓ ao rodar testes, nunca em produção)
# TESTING=1
